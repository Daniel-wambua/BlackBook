# Copy to .env and adjust. Environment variables override config.yaml values.
# All paths support ~ expansion.

# Location of the BlackBook data directory (SQLite db, caches, raw checkouts).
#BLACKBOOK_HOME=~/.blackbook

# Path to the config file.
#BLACKBOOK_CONFIG=~/.blackbook/config.yaml

# Logging level: DEBUG, INFO, WARNING, ERROR
#BLACKBOOK_LOG_LEVEL=INFO

# Enable/disable semantic (embedding) retrieval. Default false.
#BLACKBOOK_EMBEDDINGS_ENABLED=false

# Local PDFs directory (only used if the local_pdfs source is enabled).
#BLACKBOOK_PDF_DIR=~/knowledge/pdfs
